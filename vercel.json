{
  "installCommand": "npm install",
  "buildCommand": "npm run frontend:deploy-build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://folio-api.onrender.com/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ]
}
